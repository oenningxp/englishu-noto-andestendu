{
  // Englishu Noto Andestêndu na Cloudflare. Usa o MESMO banco (contas) e as MESMAS imagens do Gothic.
  "name": "englishu-noto-andestendu",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "vars": {
    // Dono do app (mesmo login do Gothic, em minúsculas): não tem limite diário.
    "ADMIN_USERNAME": "oenningxp",
    // Modelo do Sam no Workers AI (melhor em gramática) e o reserva, se o principal falhar.
    "MODEL": "@cf/openai/gpt-oss-120b",
    "FALLBACK_MODEL": "@cf/openai/gpt-oss-20b", // reserva barata (o Llama 70B gastava muita cota)
    // Modelo da resposta (o que a pessoa espera). Vazio = usa o MODEL. Dá pra medir em /api/admin/speed.
    "REPLY_MODEL": "",
    // Quanto o modelo "pensa" nas correções (rodam em paralelo): low, medium ou high. "low" economiza a cota.
    "CHECK_EFFORT": "low",
    // Modelo menor e mais barato para as sugestões de resposta.
    "SUG_MODEL": "@cf/openai/gpt-oss-20b",
    // Groq (reserva grátis): a chave vai como SEGREDO no painel da Cloudflare, com o nome GROQ_API_KEY (nunca aqui).
    // "1" = usar a Groq primeiro (mais rápida); "0" = só quando a cota da Cloudflare acabar.
    "PREFER_GROQ": "1",
    // Pedidos à IA por dia para cada amigo (protege a cota grátis da Cloudflare).
    "DAILY_LIMIT": "100"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "gothic-db", "database_id": "b566f4d5-a765-47d2-84d4-08658e711149" }
  ],
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "dcec6441ad2f4ed6a33f14fb0f2cfeb3" }
  ]
}
